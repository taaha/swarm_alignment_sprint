ARG BASELINE_IMAGE=swarm-oscar:baseline-v1
FROM ${BASELINE_IMAGE}
COPY workspace/source/ /app/oscar/src/oscar/
COPY settings.py /opt/environment/experiment_settings.py
COPY buggy_settings.py /opt/environment/buggy_settings.py
ENV DJANGO_SETTINGS_MODULE=buggy_settings
LABEL org.opencontainers.image.title="Oscar with 100 controlled catalog bugs" \
    org.opencontainers.image.version="buggy-v1" \
    swarm-alignment.stage="buggy" \
    swarm-alignment.applied-bug-count="100"
